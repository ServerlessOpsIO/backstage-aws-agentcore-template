[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

# Runtime dependencies. These are installed in the image.
[packages]
strands-agents = "==1.65.0"
bedrock-agentcore = "==1.26.0"
aws-opentelemetry-distro = "==0.22.0"

# Tools for tests and scripts. These are not installed in the image.
[dev-packages]
pytest = "==9.2.0"
boto3 = "*"
{%- if values.enable_slack_app %}
pyyaml = "==6.0.3"
jsonschema = "==4.26.0"
# What the Lambda functions in src/handlers import, and what their tests need.
# Each function's own requirements.txt says what is packaged with it.
aws-lambda-powertools = "==3.40.0"
slack-sdk = "==3.47.0"
moto = {extras = ["secretsmanager", "sqs"], version = "==5.2.5"}
pytest-mock = "==3.17.0"
common = {editable = true, path = "src/common"}
{%- endif %}

[requires]
python_version = "${{ values.python_version }}"

[scripts]
test = "pytest -vv tests"
test-unit = "pytest -vv tests/unit"
play-session = "python scripts/play_session.py"
{%- if values.enable_slack_app %}
slack-app = "python scripts/slack_app"
{%- endif %}
